# Qwen GGUF API Configuration (Windows Client)
# Replace these placeholders with your active Kaggle/Cloudflare settings.

# Cloudflare Quick Tunnel URL (Generated each time cloudflared starts)
QWEN_BASE_URL=https://your-current-tunnel.trycloudflare.com

# llama-server API Authentication Key
QWEN_API_KEY=replace_with_your_secret_key

# OpenAI-compatible model identifier
QWEN_MODEL=qwen

# HTTP Request Timeout in seconds (default: 300 for 27B model generation)
QWEN_TIMEOUT=300

# Kaggle Automation (Optional - for pushing and monitoring kernels from Windows)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KERNEL_SLUG=your_kaggle_username/swift-server
